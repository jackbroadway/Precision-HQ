# Copy this file to .env (or set these as real environment variables /
# hosting-provider secrets) and fill in your values. Never commit .env.

TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_TOPIC_ID=

# Shared secret TradingView must send back in the alert JSON body (as
# "secret"). Strongly recommended — without it, anyone who finds your
# webhook URL can post fake signals to your channel. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRADINGVIEW_WEBHOOK_SECRET=

# Trade level config (in pips)
SL_PIPS=100
TP_PIPS=80,200,300

# Move SL to breakeven (entry price) after this TP number hits. Set to 0
# to disable and keep the original SL for the whole trade.
BREAKEVEN_AFTER_TP=1

# Show a 4th open-ended "TPn - OPEN" runner target with no fixed price
# after the fixed TPs. It's never auto-closed by hitting a price — the
# position only closes on SL/breakeven. Set to "false" to go back to
# closing once every fixed TP has hit.
OPEN_RUNNER_ENABLED=true

# Footer shown on every signal message.
DISCLAIMER_TEXT=NOT FINANCIAL ADVICE. THIS IS A PERSONAL TRADE IDEA.

# Include the symbol in the "BUY NOW - ..." header line. Turn off if every
# alert already goes to its own symbol-specific Telegram topic.
INCLUDE_SYMBOL_IN_HEADER=true

# How often monitor.py polls for price updates
POLL_INTERVAL_SECONDS=30

# Only take new alerts inside this UTC window (Asia/Tokyo session by
# default). Already-open positions are still monitored 24/7.
ASIA_SESSION_START_UTC=00:00
ASIA_SESSION_END_UTC=09:00

# Web server port (webhook_server.py)
PORT=8080

# Set to "false" if running monitor.py as its own process (recommended
# for production / multi-worker gunicorn deployments)
RUN_MONITOR_IN_PROCESS=true

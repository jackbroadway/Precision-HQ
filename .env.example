# Required Netlify environment variables for the live testimonials feed
# (Site settings -> Environment variables in the Netlify dashboard).
# Never commit real values here.

# Token from @BotFather after creating the bot.
TELEGRAM_BOT_TOKEN=

# Numeric chat ID of the private testimonials group the bot reads from.
TELEGRAM_GROUP_ID=

# Any random string. Set the same value when registering the webhook with
# Telegram (see setup steps) so the function can verify requests really
# came from Telegram.
TELEGRAM_WEBHOOK_SECRET=

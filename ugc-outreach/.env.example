# Copy this file to .env and fill in your values.
# .env is gitignored — your real credentials never get committed.

# Gmail address to send outreach emails from
GMAIL_ADDRESS=youraddress@gmail.com

# A Gmail "app password" (NOT your normal Gmail password) — see README.md
# for how to generate one.
GMAIL_APP_PASSWORD=

# Any random string, used to sign the app's session/flash cookies.
FLASK_SECRET_KEY=change-me-to-something-random

# Password required to use the dashboard. Leave blank to run with no login
# (fine for local-only use on your own machine; set this before deploying
# anywhere reachable over the internet).
ACCESS_PASSWORD=

# Optional
PORT=5000
# Set to 1 once deployed behind HTTPS (Render/Railway both provide this) so
# the login cookie is only ever sent over an encrypted connection.
SESSION_COOKIE_SECURE=0
